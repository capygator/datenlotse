{
  "$defs": {
    "Definition": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "pattern": "^stakeholder\\.[a-z0-9][a-z0-9_-]*$",
          "title": "By",
          "type": "string"
        },
        "statement": {
          "anyOf": [
            {
              "pattern": "^statement\\.[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "by",
        "text"
      ],
      "title": "Definition",
      "type": "object"
    },
    "QualityRule": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "title": "QualityRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "definitions": {
      "default": [],
