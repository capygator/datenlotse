      },
      "title": "Definitions",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "from_tables": {
      "default": [],
      "items": {
        "pattern": "^table\\.[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "From Tables",
      "type": "array"
    },
    "grain": {
      "default": [],
      "items": {
        "pattern": "^dimension\\.[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "Grain",
      "type": "array"
    },
    "id": {
      "pattern": "^measure\\.[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "pattern": "^stakeholder\\.[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "quality": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QualityRule"
      },
      "title": "Quality",
      "type": "array"
    },
    "serves": {
      "default": [],
      "items": {
        "pattern": "^decision\\.[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "Serves",
      "type": "array"
    },
    "statement": {
      "anyOf": [
        {
          "pattern": "^statement\\.[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statement"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "agreed",
        "conflict"
      ],
      "title": "Status",
      "type": "string"
    },
    "time_logic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Logic"
