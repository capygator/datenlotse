{
  "$defs": {
    "Column": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "key": {
          "default": false,
          "title": "Key",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "references": {
          "anyOf": [
            {
              "pattern": "^table\\.[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "References"
        },
        "type": {
          "default": "string",
          "enum": [
            "string",
            "int64",
            "decimal",
            "double",
            "date",
            "datetime",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Column",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "columns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Column"
      },
      "title": "Columns",
      "type": "array"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "from_sources": {
      "default": [],
      "items": {
        "pattern": "^source\\.[a-z0-9][a-z0-9_-]*$",
        "type": "string"
      },
      "title": "From Sources",
      "type": "array"
    },
    "id": {
      "pattern": "^table\\.[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "fact",
        "dimension"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "pattern": "^stakeholder\\.[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "statement": {
      "anyOf": [
        {
          "pattern": "^statement\\.[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Statement"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "agreed",
        "conflict"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "name",
    "id",
    "kind"
  ],
  "title": "Table",
  "type": "object"
}
