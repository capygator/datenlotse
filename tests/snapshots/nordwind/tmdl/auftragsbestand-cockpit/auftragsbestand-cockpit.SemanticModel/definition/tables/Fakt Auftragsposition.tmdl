/// lotse: table.fact_auftragsposition (fact, Status: agreed)
table 'Fakt Auftragsposition'
	lineageTag: cac9e54d-69a4-5b0c-bd23-90dc61ecb15e

	/// Platzhalter: DAX noch nicht umgesetzt (lotse: measure.auftragsbestand, Status: agreed).
	/// Definition (Leitung Vertrieb): Summe aller bestätigten, noch nicht gelieferten Auftragspositionen
	/// Einheit: EUR · Zeitlogik: Stichtag Monatsende · Grain: Kunde, Produkt, Monat
	/// Qualität: not_negative
	measure Auftragsbestand = BLANK()
		formatString: #,##0 €
		lineageTag: ad109ed9-b206-5b15-81c6-6a91ecbf002a

		annotation lotse_id = measure.auftragsbestand

	/// Platzhalter: DAX noch nicht umgesetzt (lotse: measure.auftragseingang, Status: agreed).
	/// Definition (Leitung Vertrieb): Nettowert der im Monat bestätigten Auftragspositionen
	/// Einheit: EUR · Zeitlogik: Bestätigungsdatum im Betrachtungsmonat · Grain: Vertriebsregion, Produkt, Monat
	/// Qualität: not_negative
	measure Auftragseingang = BLANK()
		formatString: #,##0 €
		lineageTag: d417afb0-c649-506d-a5d2-2bcf709669c4

		annotation lotse_id = measure.auftragseingang

	/// Platzhalter: DAX noch nicht umgesetzt (lotse: measure.auftragsreichweite, Status: agreed).
	/// Definition (Leitung Controlling): Auftragsbestand in Fertigungsstunden geteilt durch die durchschnittliche Monatskapazität
	/// Einheit: Monate · Zeitlogik: Stichtag Monatsende · Grain: Werk, Monat
	/// Qualität: not_negative
	measure Auftragsreichweite = BLANK()
		formatString: #,##0.00
		lineageTag: bf05d3f2-cd85-52c5-96d0-2fc269b9a402

		annotation lotse_id = measure.auftragsreichweite

	/// Platzhalter: DAX noch nicht umgesetzt (lotse: measure.kapazitaetsauslastung, Status: agreed).
	/// Definition (Leitung Fertigungsplanung): Geplante Fertigungsstunden aus dem Auftragsbestand geteilt durch verfügbare Kapazitätsstunden
	/// Einheit: % · Zeitlogik: Planmonat · Grain: Werk, Monat
	/// Qualität: not_negative
	measure Kapazitätsauslastung = BLANK()
		formatString: 0.0 %
		lineageTag: 08327ba7-29dd-57f9-887e-68771eebe11e

		annotation lotse_id = measure.kapazitaetsauslastung

